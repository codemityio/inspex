export SHELL:=/bin/bash
export MAKEFLAGS+=--no-print-directory
export DEBUG:=false
export VENDOR:=codemityio
export GOTOOLCHAIN:=go$(shell sed -n 's/^go \(.*\)$$/\1/p' go.mod | head -1)
export GOPRIVATE:=github.com/${VENDOR}
export BASE_NAME:=$(shell basename ${PWD})
export IMAGE_NAME:=${VENDOR}/${BASE_NAME}
export MINIMUM_COVERAGE:=72
